COMPOSE_PROJECT_NAME=ark
ARK_SERVER_VOLUME=ark-data
# Uncomment together with the /cluster mount in docker-compose.yml
#ARK_CLUSTER_VOLUME=ark-cluster
# Uncomment for non-anonymous downloads, see README "Configure a Steam login session"
# (create the session with ./steam-login.sh first)
#STEAM_LOGIN=your_steam_username
#STEAM_SESSION_VOLUME=./Steam
SESSION_NAME=Dockerized ARK Server by github.com/hermsi1337
SERVER_MAP=TheIsland
SERVER_PASSWORD=YouShallNotPass
ADMIN_PASSWORD=topsecret
MAX_PLAYERS=20
UPDATE_ON_START=true
BACKUP_ON_STOP=false
PRE_UPDATE_BACKUP=true
WARN_ON_STOP=true
# Uncomment to cap the size of /app/backup, 0 disables the pruning of old
# backups. Read the README section "Backup retention" first, the budget is
# shared by every instance
#MAX_BACKUP_SIZE_MB=2048
# Uncomment to restart an instance that crashes before it finished starting.
# Read the README section "Crash restarts" first, this can loop endlessly
#ALWAYS_RESTART_ON_CRASH=true
# Scheduled backup and update (5-field cron schedules), see README "Add cronjobs"
#BACKUP_CRON=0 3 * * *
#UPDATE_CRON=0 4 * * *
# Minutes of warning before a scheduled update kicks players out
#UPDATE_WARN_MINUTES=30
# Container timezone, the cron schedules above follow it
TZ=UTC
# Uncomment to run the server with a custom UID/GID (e.g. NAS bind mounts)
#PUID=1000
#PGID=1000
# Additional ARK command line options, space separated (-Flag or -Name=Value)
ARK_EXTRA_OPTS=
# Uncomment to get Discord notifications on start, stop, crash and restart.
# Treat the webhook URL as a secret.
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
